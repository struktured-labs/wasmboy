{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": false,
    "noImplicitAny": false,
    "moduleResolution": "node",
    "target": "ES2017",
    "module": "ES2015",
    "lib": ["ES2017", "DOM", "DOM.Iterable"],
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "types": []
  },
  "include": ["types/**/*.d.ts", "types/**/*.ts"],
  "exclude": ["node_modules"]
}
